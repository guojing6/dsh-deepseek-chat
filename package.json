{
  "name": "@guojing6/dsh-deepseek-chat",
  "version": "3.1.3",
  "description": "DeepSeek Harness Desktop client plugin: a right-sidebar DeepSeek Chat tab that embeds chat.deepseek.com beside the conversation, with a guide card, Ctrl+Q and a session-header switch. Desktop-only; the Web surface registers no UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.2.2-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "chat",
    "web-chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guojing6/dsh-deepseek-chat.git"
  },
  "homepage": "https://github.com/guojing6/dsh-deepseek-chat#readme",
  "bugs": {
    "url": "https://github.com/guojing6/dsh-deepseek-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "test:sandbox": "node --test --test-isolation=none",
    "check": "node --check lib/client.js && node --check lib/index.js"
  }
}
